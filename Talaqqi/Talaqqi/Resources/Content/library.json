            "endFrame": 686196,
            "sampleRate": 44100
          },
          "verse": 255,
          "index": 2
        },
        {
          "arabic": "لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ",
          "phonetic": "lahoo maa fis samaawaati wa-maa fil ard:(i)",
          "translation": "A Lui appartient tout ce qui est dans les cieux et sur la terre.",
          "audio": {
            "file": "hudhaify_002255.m4a",
            "startFrame": 719271,
            "endFrame": 906696,
            "sampleRate": 44100
          },
          "verse": 255,
          "index": 3
        },
        {
          "arabic": "مَن ذَا ٱلَّذِي يَشۡفَعُ عِندَهُۥٓ إِلَّا بِإِذۡنِهِۦۚ",
          "phonetic": "man zal lazee yashfa'u indahooo illaa bi-iznih,(i)",
          "translation": "Qui peut intercéder auprès de Lui sans Sa permission?",
